# =============================================================================
# Jimplas Capital Management — BSv3.2 Supervisory Platform
# Copy to .env and set all secrets before deploy:  .\scripts\pre-deploy.ps1
# =============================================================================

# Application
APP_NAME=JCM-BSv32-Platform
APP_ENV=production
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://YOUR_VPS_IP:3000

# Public URLs (deploy.ps1 uses PLATFORM_PUBLIC_URL to configure frontend)
PLATFORM_PUBLIC_URL=http://YOUR_VPS_IP:8000
API_BIND=0.0.0.0
FRONTEND_BIND=0.0.0.0
UVICORN_WORKERS=1

# PostgreSQL (deploy.ps1 sets POSTGRES_HOST=postgres for Docker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jcm_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jcm_bsv32
DATABASE_URL=postgresql+asyncpg://jcm_admin:change-me-strong-password@postgres:5432/jcm_bsv32

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# External APIs — use host.docker.internal when APIs run on the VPS host
MT5_API_URL=http://host.docker.internal:8765
MT5_API_KEY=
DESK_API_URL=http://host.docker.internal:8791
DESK_API_KEY=
FORWARD_BOT_API_URL=http://host.docker.internal:8083
FORWARD_BOT_API_KEY=
WATCHDOG_API_URL=http://host.docker.internal:8084
WATCHDOG_API_KEY=

# BSv3.2 installation folder (Bilshenz Strategy v3.2 — change to your path)
# Used by wire-bsv32-integration.ps1 and set-bsv32-home.ps1
BSV32_HOME=C:\opt\bilshenz

# BSv3.2 Event Ingestion
EVENT_WEBHOOK_SECRET=change-me-webhook-secret
EVENT_INGESTION_BATCH_SIZE=100

# Infrastructure Resilience Agent
VPS_HOST=YOUR_VPS_IP
VPS_SSH_USER=deploy
INFRA_CHECK_INTERVAL_SECONDS=30
INFRA_RESTART_MAX_RETRIES=3
INFRA_BACKOFF_BASE_SECONDS=5

# Alerting (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# Portfolio Risk
MAX_ACCOUNT_DRAWDOWN_PCT=5.0
MAX_DAILY_DRAWDOWN_PCT=2.0
MAX_CONCURRENT_POSITIONS=3
CORRELATION_THRESHOLD=0.75
TRADE_FREQUENCY_LIMIT_PER_HOUR=6

# Performance Intelligence
PERF_REPORT_CRON=0 0 * * *
EDGE_DECAY_LOOKBACK_DAYS=90
ANOMALY_ZSCORE_THRESHOLD=2.5

# Research Evolution
RESEARCH_MIN_SAMPLE_SIZE=30
RESEARCH_DRIFT_WINDOW_DAYS=30

# Marketing Agent
MARKETING_DOCS_PATH=/app/docs
MARKETING_CYCLE_HOURS=24
MARKETING_AUTO_APPROVE=false

# Daily CEO executive briefing (09:00 local)
EXECUTIVE_BRIEFING_TIMEZONE=Africa/Kampala
EXECUTIVE_BRIEFING_HOUR=9
EXECUTIVE_BRIEFING_MINUTE=0
EXECUTIVE_BRIEFING_CEO_NAME=Billy Jimplas
EXECUTIVE_BRIEFING_RUN_AGENTS_BEFORE=true
EXECUTIVE_BRIEFING_TELEGRAM_NOTIFY=true
MISSION_CONTROL_PUBLIC_URL=http://104.194.140.203:8000

# Security
STRICT_SECURITY=false
RATE_LIMIT_PER_MINUTE=120
METRICS_REQUIRE_AUTH=false

# CEO Copilot (Mission Control) — owner-only access via HTTP Basic Auth
MISSION_CONTROL_USER=your-email@example.com
MISSION_CONTROL_PASSWORD=change-me-strong-mission-control-password
MISSION_CONTROL_REQUIRE_AUTH=true

# Prometheus
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# Frontend (deploy.ps1 syncs these from PLATFORM_PUBLIC_URL + API_SECRET_KEY)
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:8000
NEXT_PUBLIC_WS_URL=ws://YOUR_VPS_IP:8000/ws
NEXT_PUBLIC_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
