# =============================================================================
# Jimplas Capital Management — BSv3.2 Supervisory Platform
# =============================================================================

# Application
APP_NAME=JCM-BSv32-Platform
APP_ENV=production
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,https://dashboard.jimplas.com

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=jcm_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jcm_bsv32
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# External APIs (read-only observation — never override BSv3.2)
MT5_API_URL=http://mt5-bridge:8081
MT5_API_KEY=
DESK_API_URL=http://desk-api:8082
DESK_API_KEY=
FORWARD_BOT_API_URL=http://forward-bot:8083
FORWARD_BOT_API_KEY=
WATCHDOG_API_URL=http://watchdog:8084
WATCHDOG_API_KEY=

# BSv3.2 Event Ingestion (webhook from execution layer)
EVENT_WEBHOOK_SECRET=change-me-webhook-secret
EVENT_INGESTION_BATCH_SIZE=100

# Infrastructure Resilience Agent
VPS_HOST=trading-vps.internal
VPS_SSH_USER=deploy
INFRA_CHECK_INTERVAL_SECONDS=30
INFRA_RESTART_MAX_RETRIES=3
INFRA_BACKOFF_BASE_SECONDS=5

# Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=alerts@jimplas.com
ALERT_EMAIL_TO=ceo@jimplas.com
ALERT_EMAIL_PASSWORD=

# Portfolio Risk Orchestrator
MAX_ACCOUNT_DRAWDOWN_PCT=5.0
MAX_DAILY_DRAWDOWN_PCT=2.0
MAX_CONCURRENT_POSITIONS=3
CORRELATION_THRESHOLD=0.75
TRADE_FREQUENCY_LIMIT_PER_HOUR=6

# Performance Intelligence Agent
PERF_REPORT_CRON=0 0 * * *
PERF_WEEKLY_REPORT_DAY=monday
EDGE_DECAY_LOOKBACK_DAYS=90
ANOMALY_ZSCORE_THRESHOLD=2.5

# Research Evolution Agent
RESEARCH_REVIEW_QUEUE_ENABLED=true
RESEARCH_MIN_SAMPLE_SIZE=30
RESEARCH_DRIFT_WINDOW_DAYS=30

# Prometheus
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
