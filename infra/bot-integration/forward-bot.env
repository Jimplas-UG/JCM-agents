# Copy from bsv32-forward-bot.env — same integration template for forward-bot hosts.
# Server: set PLATFORM_HOST / JCM_INGEST_WEBHOOK_URL for your VPS.

JCM_INGEST_WEBHOOK_URL=http://YOUR_VPS_IP:8000/ingest/event
JCM_WEBHOOK_SECRET=change-me-webhook-secret
JCM_WEBHOOK_HEADER=X-Webhook-Secret
JCM_INGEST_BATCH_URL=http://YOUR_VPS_IP:8000/ingest/batch

MT5_API_KEY=change-me-mt5-key
DESK_API_KEY=change-me-desk-key
FORWARD_BOT_API_KEY=change-me-forward-key
WATCHDOG_API_KEY=change-me-watchdog-key
