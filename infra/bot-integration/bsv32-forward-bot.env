# Webhook: POST trade/filter/system events to JCM supervisory platform
JCM_INGEST_WEBHOOK_URL=http://104.194.140.203:8000/ingest/event
JCM_WEBHOOK_SECRET=change-me-webhook-secret
JCM_WEBHOOK_HEADER=X-Webhook-Secret

# Optional batch endpoint
JCM_INGEST_BATCH_URL=http://104.194.140.203:8000/ingest/batch

# Service API keys (set matching keys on mt5-bridge, desk-api, forward-bot, watchdog)
MT5_API_KEY=change-me-mt5-key
DESK_API_KEY=change-me-desk-key
FORWARD_BOT_API_KEY=change-me-forward-key
WATCHDOG_API_KEY=change-me-watchdog-key

# Example webhook client (curl)
# curl -X POST "%JCM_INGEST_WEBHOOK_URL%" ^
#   -H "Content-Type: application/json" ^
#   -H "X-Webhook-Secret: %JCM_WEBHOOK_SECRET%" ^
#   -d "{\"event_type\":\"trade_executed\",\"payload\":{...}}"
